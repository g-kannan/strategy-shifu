  "calculationModel": {
    "runtime": "monthlyHours is hoursPerDay * daysPerMonth for monthly schedules, or round(hoursPerDay * daysPerWeek * 730 / 168) for weekly schedules; 24 hours/day and 31 days/month is fixed at 730 hours.",
